{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://neon-reserve-api-staging.lazydevpro.workers.dev",
        "EXPO_PUBLIC_SOLANA_CLUSTER": "devnet"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://neon-reserve-api-staging.lazydevpro.workers.dev",
        "EXPO_PUBLIC_SOLANA_CLUSTER": "devnet"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://kept-api.lazydevpro.workers.dev",
        "EXPO_PUBLIC_SOLANA_CLUSTER": "mainnet-beta",
        "EXPO_PUBLIC_SITE_URL": "https://keptapp.pages.dev"
      }
    }
  },
  "submit": { "production": {} }
}
