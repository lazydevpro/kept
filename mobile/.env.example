# Android emulator default: http://10.0.2.2:8787
# Physical phones need your computer's LAN address, for example http://192.168.1.20:8787
EXPO_PUBLIC_API_URL=http://10.0.2.2:8787
# Keep this omitted for safe devnet use. Set both values only for a deliberate live build.
# EXPO_PUBLIC_SOLANA_CLUSTER=mainnet-beta
# EXPO_PUBLIC_SOLANA_RPC_URL=https://your-production-rpc.example
