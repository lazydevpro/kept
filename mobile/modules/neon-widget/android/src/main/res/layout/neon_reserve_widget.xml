<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/neon_widget_background"
  android:gravity="center_vertical"
  android:orientation="horizontal"
  android:padding="16dp">

  <ImageView
    android:id="@+id/widget_rings"
    android:layout_width="104dp"
    android:layout_height="104dp"
    android:contentDescription="@string/kept_widget_rings_description" />

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="14dp"
    android:layout_weight="1"
    android:orientation="vertical">

    <!-- The eyebrow matches the app's `eyebrow` role: small, tracked out, quiet. -->
    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:letterSpacing="0.12"
      android:text="@string/kept_widget_eyebrow"
      android:textColor="@color/kept_kiwi_deep"
      android:textSize="10sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/widget_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="7dp"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="@color/kept_ink"
      android:textSize="17sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/widget_message"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:ellipsize="end"
      android:maxLines="2"
      android:textColor="@color/kept_ink_muted"
      android:textSize="12sp" />
  </LinearLayout>
</LinearLayout>
