{
  "expo": {
    "name": "KEPT",
    "slug": "neon-reserve",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "neonreserve",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:kept.lazydevpro.workers.dev"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FBFBF4",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.lazydevpro.neonreserve",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "kept.lazydevpro.workers.dev",
              "pathPrefix": "/join"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-blank.png",
          "imageWidth": 64,
          "resizeMode": "contain",
          "backgroundColor": "#FBFBF4",
          "dark": {
            "backgroundColor": "#0C0F0A"
          }
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      "expo-notifications",
      "expo-sharing"
    ],
    "experiments": {
      "reactCompiler": true,
      "typedRoutes": true
    }
  }
}
